# Always skip: generated output, dependencies, local data, and tool caches.
# These are not product source. Cursor should not index or read them.
#
# Skip-unless trees (legacy UIs and the vendored SQLite driver) live in
# .cursorindexingignore. That file only drops them from the codebase index.
# Agent Grep and Glob still walk those trees so a task about them can open
# a file without editing this list.

# Cargo / Tauri build output
target/
debug/
src-tauri/gen/

# npm packages and frontend build output
**/node_modules/
web/dist/
web-next/.next/
web-next/out/
docs/.astro/
docs/dist/
docs/public/docs/developer/rustdoc/
/static/

# Local server data and generated demo copies
/data/
crates/server/demo-seed/staging/

# Scratch, caches, packaging, and local export trees
.tmp/
.npm-cache/
/dist/
/out/
/staging/
/staging-*/
/export-*/
*.log

# Tooling clones and caches (not app code)
.worktrees/
.claude/
.superpowers/

# Local secrets and machine identity
.env
.env.*
!.env.example
config/config.toml
config/export-to-server.sh
config/contacts.csv
config/contacts.vcf
**/export.ini
