# Git / IDE
.git
.github
.cursor
.vscode
.idea

# Accidental root lockfile confuses Next.js workspace root detection
/package-lock.json
/package.json

# Local database at the repo root (never bake personal data into an image).
# Do not ignore every `data/` folder — demo-seed reads
# crates/server/demo-seed/data/corpus/pride-and-prejudice.txt when the
# rust-builder stage runs `cargo run -p demo-seed`.
/data
*.db
*.db-journal
*.db-wal
*.db-shm
config/config.toml
config/contacts.csv
config/contacts.vcf
.env

# Build artifacts
target
**/target
web/node_modules
web/.next
web/tsconfig.tsbuildinfo
docs/node_modules
docs/.astro
docs/dist

# Local export working trees at repo root
/staging
/sources

# Generated demo conversations (built in the rust-builder stage)
/crates/server/demo-seed/staging
