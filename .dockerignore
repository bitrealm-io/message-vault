target
**/target
web/node_modules
web/tsconfig.tsbuildinfo
docs/node_modules
docs/.astro
docs/dist

# Local export working trees at repo root
/staging
/sources

# Generated demo conversations (cargo run -p demo-seed)
/crates/server/demo-seed/staging
