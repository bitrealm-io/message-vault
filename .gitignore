# Generated by Cargo
# will have compiled files and executables
debug
target

# Generated by Tauri (regenerated by tauri-build on every build)
src-tauri/gen/schemas

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local machine export paths / owner identity
config/export-to-vault.sh
config/config.toml
config/contacts.csv
config/contacts.vcf
**/export.ini

# Local machine config (copy .env.example to .env)
.env

# Converter output trees (directory kept via .gitkeep)
/data/*
!/data/.gitkeep

# Starlight documentation output
/docs/.astro/
/docs/dist/
/docs/node_modules/
/docs/public/vault/developer/rustdoc/

# PlantUML extension default dump (workspace export goes to docs/maintainers/architecture/puml/img)
/out/

# Local release packaging output
/dist/

# Local CLI / GUI run artifacts
*.log
/staging-*/
/export-*/

# Generated demo conversations and attachment copies (cargo run -p demo-seed)
/crates/vault/demo-seed/staging/

# Frontend (web/) dependencies and build output
/web/node_modules/
/web/dist/

# Restored Next.js browse UI (web-next/)
/web-next/node_modules/
/web-next/.next/
/web-next/out/
# Local agent tooling (not version controlled)
.claude/
.cursor/
.worktrees/
.superpowers/

# Local npm cache and scratch dirs
/.npm-cache/
/.tmp/
