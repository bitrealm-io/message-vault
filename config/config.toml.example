# Copy to config.toml and edit for your machine:
#   cp config/config.toml.example config/config.toml
#
# Instance config only: shared database path, per-account data root, and optional
# HTTP import server. Web accounts (user ID + optional password) and identity
# (preferred name / phones / optional email handles) live in SQLite. Create an
# account in the web UI, then import with `--account <username>` (CLI) or your
# Import API token (Message Exporters).
#
# Message Exporters writes JSONL + attachments and uploads with a source name.
# Source folders are not listed here — each import registers its own source for
# that account under data/<account_id>/<source_id>/.
#
# Address books load into SQLite via CLI `import-contacts --contacts`
# (VCF or vCard CSV).
# Older contact_phones / preferred_phone DBs are not upgraded — wipe messagecrate.db and re-import.

[paths]
db = "data/messagecrate.db"
data_dir = "data"
assets_dir = "assets"
assets_converted_dir = "assets_converted"

# HTTP JSONL import API (`cargo run --release -- serve`).
# Auth uses per-account Import API tokens from the web Settings UI (not a host secret).
[server]
bind = "127.0.0.1:8080"
# Largest multipart chunk. Default 64 MiB (keep under ~100 MB for Cloudflare).
# The attachment size limit has no key here: the owner sets it under Server
# Settings in the app (512 MiB until then). When the limit is smaller than this
# chunk size, the server uses chunks the size of the limit.
# asset_part_size = 67108864

# Extra CORS allowed origins. Two kinds of UI need no entry here: the website
# this process serves (same origin), and the packaged desktop app, whose three
# origins — tauri://localhost (Linux AppImage / macOS), http://tauri.localhost
# (Windows) and https://tauri.localhost (Windows HTTPS scheme) — are built in.
# Add an origin when some other UI calls this API on a different host/port:
# - Vite / `cargo tauri dev`: http://localhost:5173 and http://127.0.0.1:5173
# Use ["*"] only for local debugging.
# Keep this array on one line: scripts/run-dev.sh uncomments only this line.
# cors_origins = ["http://localhost:5173", "http://127.0.0.1:5173", "https://tauri.localhost", "http://tauri.localhost", "tauri://localhost"]

# Folder holding the built website, served at /. Default "static", relative to
# the directory the server is started in. `serve --static-dir` overrides it.
# static_dir = "static"

# Serve an interactive OpenAPI explorer at /docs (and /openapi.json).
# Default false. Calls from the explorer still need a Bearer token.
# openapi_ui = false
