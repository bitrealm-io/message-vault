@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Left to right layout
LAYOUT_LANDSCAPE()
LAYOUT_WITH_LEGEND()

title System Context: Message Crate Server

Person(user, "User", "A person who wants to store messages from a device or platform.")

System(ui, "User Interface", "Allows users to view, search, upload, export, and maintain messages.")
System(server, "Message Crate Backend", "Handles core messaging operations including storage and retrieval.")

Rel(user, ui, "Imports and views messages")
Rel(ui, server, "Stores and retrieves messages")

@enduml