---
import LandingLayout from "../layouts/LandingLayout.astro";
import { landingLinks } from "../lib/landing-links";
---

<LandingLayout
  title="Changelog · Message Vault"
  description="Release history for Message Vault."
  canonicalPath="/changelog/"
>
  <main class="mv-stub">
    <h1>Changelog</h1>
    <p>
      Project history is tracked in
      <code>CHANGELOG.md</code>
      in the repository. Installable builds live on GitHub Releases.
    </p>

    <div class="mv-stub-block">
      <h2>What it covers</h2>
      <p>
        Every release from 0.1.0 onwards, grouped as features, fixes and design
        changes, written for the people who use Message Vault. Changes for the
        next release are listed under the version in development.
      </p>
    </div>

    <div class="mv-stub-block">
      <h2>Links</h2>
      <p>
        <a href={landingLinks.githubChangelog}>CHANGELOG.md on GitHub</a>
        ·
        <a href={landingLinks.download}>GitHub Releases</a>
      </p>
    </div>
  </main>
</LandingLayout>
