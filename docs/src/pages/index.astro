---
import LandingLayout from "../layouts/LandingLayout.astro";
import { landingLinks } from "../lib/landing-links";

const features = [
  {
    title: "Multiple import sources",
    body: "Bring in SMS, iMessage, WhatsApp, and other supported phone backups from one desktop workflow.",
  },
  {
    title: "Advanced search",
    body: "Find a conversation, keyword, date range, or attachment without scrolling forever.",
  },
  {
    title: "Native-style viewing",
    body: "Read threads in a familiar chat layout so old messages still feel like messages.",
  },
  {
    title: "Local and private",
    body: "Your archive lives where you run it—on your machine or a server you control. Not a stranger’s cloud account.",
  },
  {
    title: "Export anytime",
    body: "Take clean copies in open formats whenever you want. Nothing is locked in.",
  },
  {
    title: "Self-hosted control",
    body: "Run from source, with Docker, or via the desktop app. You choose uptime, storage, and access.",
  },
] as const;

const steps = [
  {
    num: "01",
    title: "Run Message Crate",
    body: "Install the desktop app, run from source, or start the published Docker image—no cloud account required.",
  },
  {
    num: "02",
    title: "Import your history",
    body: "Point Message Crate at phone backups you already have and bring conversations into one local library.",
  },
  {
    num: "03",
    title: "Search and export",
    body: "Find any message quickly, browse threads, and export when you need a portable copy.",
  },
] as const;
---

<LandingLayout
  title="Message Crate"
  description="Extract messages from phone backups onto a server you control. Browse, search, and export on your terms."
  canonicalPath="/"
>
  <main>
    <section class="mc-hero">
      <div class="mc-hero-inner">
        <div>
          <span class="mc-eyebrow">Self-hosted and private</span>
          <h1>Every message you’ve ever sent, preserved forever.</h1>
          <p class="mc-lede">
            Message Crate turns phone-backup chat history into one searchable
            library you run yourself—SMS, iMessage, WhatsApp, and more.
          </p>
          <div class="mc-hero-actions">
            <a
              class="mc-btn mc-btn-primary mc-btn-lg"
              href={landingLinks.download}>Download</a
            >
            <a class="mc-btn mc-btn-ghost mc-btn-lg" href={landingLinks.features}
              >See features</a
            >
          </div>
        </div>
        <figure class="mc-hero-visual">
          <img
            src="/landing/hero-messages.avif"
            alt="Message conversation preview"
            width="960"
            height="720"
            loading="eager"
          />
        </figure>
      </div>
    </section>

    <section class="mc-section mc-section-alt" id="features">
      <div class="mc-section-inner">
        <div class="mc-section-head">
          <span class="mc-kicker">Why Message Crate</span>
          <h2>The archive you’ll actually want to keep</h2>
          <p>
            Stop losing years of conversations. Turn scattered chat history into
            one searchable, private library.
          </p>
        </div>
        <div class="mc-feature-grid">
          {
            features.map((feature) => (
              <article class="mc-feature">
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="mc-section">
      <div class="mc-section-inner">
        <div class="mc-section-head">
          <span class="mc-kicker">How it works</span>
          <h2>Up and running in three steps</h2>
        </div>
        <div class="mc-steps">
          {
            steps.map((step) => (
              <article class="mc-step">
                <span class="mc-step-num">{step.num}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</LandingLayout>
