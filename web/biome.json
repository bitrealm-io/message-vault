{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".."
  },
  "files": {
    "includes": ["**", "!!**/dist", "!package-lock.json", "!src/lib/serverApi.types.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error",
        "noRestrictedElements": {
          "level": "error",
          "options": {
            "elements": {
              "button": "Use Button or PlainButton from src/components, which are React Aria's Button (STYLE_GUIDE.md, rule 4)."
            }
          }
        }
      },
      "style": {
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": {
            "allowConstantExport": true,
            "allowExportNames": [
              "ATTACHMENT_OPTIONS",
              "ListBoxItem",
              "RESOLUTION_OPTIONS",
              "bubbleBody",
              "completionTextFor",
              "fieldStyle",
              "formatCompare",
              "formatMessageTime",
              "hintStyle",
              "isGroupConversation",
              "mockedAuth",
              "renderWithProviders",
              "sectionGap",
              "selectItemClassName",
              "senderName",
              "tapbackGroups",
              "testQueryClient",
              "useAuth",
              "useTheme"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noRestrictedElements": "off"
          },
          "style": {
            "useComponentExportOnlyModules": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
